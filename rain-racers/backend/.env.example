# Where the database and uploaded files live. On Railway: a volume mounted at /data.
DATA_DIR=./data
# Prisma reads a relative path from the prisma/ folder, so ../data is backend/data.
# On Railway: file:/data/rain-racers.db
DATABASE_URL=file:../data/rain-racers.db

# Signs the login cookies. Long and random (40+ characters), never shared.
JWT_SECRET=change-me

# PIN for the admin area (/admin).
ADMIN_PIN=1234

# Discord login (https://discord.com/developers/applications -> OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
# Discord user ids that get the admin area without the PIN (comma separated).
ADMIN_DISCORD_IDS=

PORT=4000

# An empty database gets the league's history (seed/) on its first start.
# "off" starts empty instead.
# SEED_HISTORY=off
