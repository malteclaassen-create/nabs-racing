# Dependencies
node_modules/

# Build output
dist/

# Environment / secrets
.env
.env.*
!.env.example
*.local
# The Discord bot's login token, kept here by hand so it is findable. The bot
# itself reads DISCORD_TOKEN from the environment, not from this folder.
token/

# Local SQLite database (generated by `npm run seed`)
*.db
*.db-journal
# WAL-mode side files (created once journal_mode=WAL is set in lib/prisma.js)
*.db-wal
*.db-shm
backend/prisma/dev.db

# User uploads (driver profile pictures, served at /api/uploads)
backend/uploads/

# Self-hosted downloads (large AC files placed on the server by the admin)
backend/downloads/*
!backend/downloads/.gitkeep

# Archived raw AC result JSONs (kept so telemetry can be recomputed later).
# Runtime data under DATA_DIR — regeneratable from imports/backfill, not source.
backend/results-archive/
# Driver-recorded laps, and the track outlines fetched from the server manager.
# Same story: runtime data that lands here whenever the server is run straight
# out of the checkout, and neither belongs in the repository.
backend/telemetry-laps/
backend/track-maps/

# Pit stops written down while a race runs (services/pitRecorder.js). Runtime
# data under DATA_DIR like the folders above, and unlike them NOT regeneratable
# — which is exactly why it belongs on the server's volume and not in here,
# where a local test recording could overwrite the real one.
backend/live-pits/

# Training best laps carried onto the live board (lib/liveBestLaps.js), and the
# times a server reset has parked waiting for an answer (lib/liveResetKeep.js).
# Runtime data under DATA_DIR, same as the folders above: what lands here on a
# dev machine is whatever the relay happened to see, and it has no business
# overwriting the real thing on the server.
backend/live-best-laps/
backend/live-reset-keep/

# Logs
*.log
npm-debug.log*

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/


# Raw source material (screenshots etc.) for rebuilding archive seasons - not site code
archive-material/

# Local dev tooling config (not part of the site)
__pycache__/

# local sqlite snapshots (never commit dev data)
dev.db.backup-*
dev.db.local-backup-*

# Pictures and clips attached to an incident report. Private by design (they
# are NOT under uploads/, which is served statically) and never in the repo.
backend/report-files/
