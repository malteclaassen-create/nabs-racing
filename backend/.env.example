# SQLite database file (no install needed)
DATABASE_URL="file:./dev.db"

# OPTIONAL: one folder for ALL persistent data (uploads/, downloads/, backups/,
# logs/). Leave unset locally — everything stays under backend/ as usual.
# On hosts that wipe the disk on every deploy (e.g. Railway) point this at the
# mounted volume, and put the database there too:
#   DATA_DIR="/data"
#   DATABASE_URL="file:/data/dev.db"
# DATA_DIR=""

# Secret used to sign admin JWTs (change this in production)
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on
PORT=4000

# Comma-separated list of allowed CORS origins (frontend dev server).
# On a real deployment this is the site's own address, e.g.
# CORS_ORIGIN="https://your-league.example.com"
# It doubles as the allowlist for "Sign in through Steam": Steam lets any site
# start a login for any address, so the return address has to be pinned to ours,
# otherwise a sign-in completed on someone else's site could be replayed here.
CORS_ORIGIN="http://localhost:5173"

# Only needed when the site is reachable under an address that is NOT in
# CORS_ORIGIN (e.g. an extra domain). Comma-free single origin, no trailing
# slash. Leave blank otherwise.
# PUBLIC_ORIGIN="https://your-league.example.com"

# --- Discord login (OPTIONAL) ---------------------------------------------
# Leave blank to disable Discord login (the site falls back to picking a driver
# from a dropdown). To enable: create an app at https://discord.com/developers,
# add an OAuth2 redirect of exactly DISCORD_REDIRECT_URI, then fill these in.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:5173/auth/discord/callback"
