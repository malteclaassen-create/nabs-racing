<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_placeholder"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_text_dim"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_label"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- The widget's running clocks, laid over the spot android.js left empty in
         the picture (LiveTimer). They count down by themselves, every second.
         Placed by padding, the only way to position a view in a home screen
         widget on every Android version. -->
    <Chronometer
        android:id="@+id/timer0"
        style="@style/WidgetClock" />

    <Chronometer
        android:id="@+id/timer1"
        style="@style/WidgetClock" />
</FrameLayout>
