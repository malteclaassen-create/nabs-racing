<?xml version="1.0" encoding="utf-8"?>
<!-- The driver name comes first: typing it opens the keyboard over the lower half
     of the screen, and a name has to be read back while it is typed. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_title"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/config_lead"
            android:textColor="@color/widget_text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/ConfigLabel"
            android:text="@string/config_driver" />

        <AutoCompleteTextView
            android:id="@+id/driver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:hint="@string/config_driver_hint"
            android:imeOptions="actionDone"
            android:inputType="textPersonName|textNoSuggestions"
            android:minHeight="48dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/driverNote"
            style="@style/ConfigNote" />

        <TextView
            style="@style/ConfigLabel"
            android:text="@string/config_series" />

        <RadioGroup
            android:id="@+id/series"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/ConfigLabel"
            android:text="@string/config_widget" />

        <Spinner
            android:id="@+id/kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/blurb"
            style="@style/ConfigNote" />

        <TextView
            style="@style/ConfigLabel"
            android:text="@string/config_preview" />

        <FrameLayout
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/widget_placeholder">

            <TextView
                android:id="@+id/previewNote"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/widget_loading"
                android:textColor="@color/widget_text_dim" />
        </FrameLayout>

        <CheckBox
            android:id="@+id/tier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/config_tier" />

        <TextView
            style="@style/ConfigNote"
            android:text="@string/config_tier_note" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/nabs_pink"
            android:minHeight="52dp"
            android:text="@string/config_add"
            android:textColor="@color/nabs_background"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
