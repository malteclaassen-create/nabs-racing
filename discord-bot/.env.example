# copy to .env and fill in

# discord developer portal -> Bot -> Reset Token
DISCORD_TOKEN=
# right-click the server -> Copy Server ID (needs developer mode)
GUILD_ID=

SITE_URL=http://localhost:4000
# Admin -> Tokens -> Discord bot
TOKEN_KEY=

# optional. channel ids, comma separated. empty = count everything
COUNT_CHANNELS=
IGNORE_CHANNELS=
COUNT_AFK_CHANNEL=true
PUSH_EVERY_MINUTES=5
