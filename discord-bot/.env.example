# copy to .env and fill in

# discord developer portal -> Bot -> Reset Token
DISCORD_TOKEN=
# right-click the server -> Copy Server ID (needs developer mode)
GUILD_ID=

SITE_URL=http://localhost:4000
# Admin -> NABS Points -> Discord bot
TOKEN_KEY=

# optional. channel ids, comma separated. empty = count everything
COUNT_CHANNELS=
IGNORE_CHANNELS=
PUSH_EVERY_MINUTES=5

# only on a host that wipes its disk on deploy (Railway): mount a volume and
# point this at it, so a restart does not lose the day so far
# STATE_PATH=/data/state.json

# voice minutes. all off: a client left running in an empty channel earns
# nothing. turn one on if the league would rather it counted anyway
COUNT_AFK_CHANNEL=false
COUNT_MUTED=false
COUNT_ALONE=false
